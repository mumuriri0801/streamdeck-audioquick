{
  "name": "audioquick-streamdeck",
  "version": "1.0.1",
  "description": "Stream Deck plugin: switch Windows audio devices by name, toggle mic mute",
  "scripts": {
    "build": "esbuild src/plugin.js --bundle --platform=node --target=node20 --format=cjs --external:bufferutil --external:utf-8-validate --outfile=com.diy.audioquick.sdPlugin/bin/plugin.js",
    "icons": "python3 build/make_icons.py com.diy.audioquick.sdPlugin",
    "test": "node --test test/logic.test.js test/compile.test.js test/integration.test.js test/ui.test.js",
    "validate": "streamdeck validate com.diy.audioquick.sdPlugin",
    "pack": "streamdeck pack com.diy.audioquick.sdPlugin --output dist --force"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@elgato/cli": "^1.10.4",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.17.0",
    "ws": "^8.23.0"
  },
  "private": true
}
